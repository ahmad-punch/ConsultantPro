# Copy to .env.local and fill in. Never commit real values.
# Every variable is optional for local development (`pnpm dev` works with none).

# --- Database -------------------------------------------------------------
# Neon Postgres connection string. Leave unset locally to use PGlite in .pglite/.
# Production: set in Vercel, then run `pnpm db:migrate` (or `pnpm db:push`).
# Unset on a deploy = demo mode: in-memory data, reset on every cold start.
DATABASE_URL=
# Demo mode only: set to 0 to start the in-memory database empty (no demo seed).
DEMO_SEED=

# --- Admin auth (control panel at /admin) ---------------------------------
# Roles (decision 0006). Sign in with email + password.
# Super admin: this email (case-insensitive) with SUPER_ADMIN_PASSWORD. Full access.
# Dev default when unset: ahmadsalmankhan137@gmail.com / "admin".
SUPER_ADMIN_EMAIL=ahmadsalmankhan137@gmail.com
SUPER_ADMIN_PASSWORD=sadmin
# Staff password: any email + this password signs in as staff (no Settings,
# templates, exports or archiving). Dev default when unset: "staff".
# Legacy: while SUPER_ADMIN_EMAIL/PASSWORD are not both set, this password
# signs in as super admin so older single-password deploys keep working.
ADMIN_PASSWORD=admin
# Optional read-only viewer password (any email). Leave empty to disable.
VIEWER_PASSWORD=view
# Secret for signing the session cookie, at least 16 characters.
# Generate with: openssl rand -base64 32. Required in production.
AUTH_SECRET=

# --- Public site ----------------------------------------------------------
# Canonical site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format, digits only (e.g. 447700900000).
# While unset, WhatsApp buttons fall back to the /start intake form.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public contact email. While unset, email links fall back to /start.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Stripe payment links (one per product; leave unset to hide the button) -
NEXT_PUBLIC_STRIPE_LINK_QUESTION=
NEXT_PUBLIC_STRIPE_LINK_CALL=
NEXT_PUBLIC_STRIPE_LINK_ASSESSMENT=
NEXT_PUBLIC_STRIPE_LINK_MANAGED=
NEXT_PUBLIC_STRIPE_LINK_ERRAND=
NEXT_PUBLIC_STRIPE_LINK_RETAINER_WATCH=
NEXT_PUBLIC_STRIPE_LINK_RETAINER_PLUS=
NEXT_PUBLIC_STRIPE_LINK_RETAINER_FAMILY_OFFICE=

# --- Stripe webhook (records card payments against cases) ------------------
# Secret API key (sk_live_... or sk_test_...). Without both, /api/stripe/webhook returns 503.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint in the Stripe dashboard (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Transactional email (Resend) -------------------------------------------
# Without both, emails are skipped with a console note; forms still work.
RESEND_API_KEY=
# Verified sender, e.g. "Rasta <hello@your-domain>".
EMAIL_FROM=
# Optional reply-to address.
EMAIL_REPLY_TO=
